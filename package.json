{
  "name": "kioku-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A public, product-neutral React design system.",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "a11y:audit": "pnpm storybook:build && node .github/scripts/accessibility-audit.js",
    "a11y:baseline": "pnpm storybook:build && node .github/scripts/accessibility-audit.js --update-baseline",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm check:repo && pnpm check:package-boundaries && pnpm lint && pnpm typecheck && pnpm test",
    "check:package-boundaries": "node internal/scripts/check-package-boundaries.mjs",
    "check:repo": "node internal/scripts/check-workspace.mjs",
    "docsite": "pnpm --dir apps/docsite dev",
    "format": "prettier --check .",
    "lint": "eslint .",
    "release": "changeset publish",
    "sandbox:build": "pnpm --dir apps/sandbox build",
    "storybook": "pnpm --dir apps/storybook storybook",
    "storybook:build": "pnpm --dir apps/storybook build",
    "sync:exports": "pnpm verify-exports",
    "test": "node --test internal/scripts/**/*.test.mjs && pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "tsc --noEmit && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "verify-exports": "pnpm --filter './packages/**' --if-present build && node internal/scripts/verify-exports.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@changesets/cli": "^2.29.7",
    "eslint": "^10.8.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}

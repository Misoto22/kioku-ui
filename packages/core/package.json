{
  "name": "@misoto22/kioku-ui",
  "version": "0.0.0",
  "description": "Product-neutral React design system foundations.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/authoring.stylex.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./authoring.stylex": {
      "types": "./dist/authoring.stylex.d.ts",
      "import": "./src/authoring.stylex.ts",
      "default": "./src/authoring.stylex.ts"
    },
    "./reset.css": "./dist/styles/reset.css",
    "./styles.css": "./dist/styles/index.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js",
      "default": "./dist/docs/index.js"
    },
    "./authoring": "./dist/authoring.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "stylex -i src -o dist -b styles/stylex.css --babelPresets @babel/preset-typescript && tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0"
  },
  "devDependencies": {
    "@misoto22/kioku-ui-test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@babel/preset-typescript": "7.28.5",
    "@stylexjs/cli": "0.19.0",
    "happy-dom": "^20.0.11"
  }
}

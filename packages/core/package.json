{
  "name": "@misoto22/kioku-ui",
  "version": "0.0.0",
  "description": "Product-neutral React design system foundations.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/authoring.stylex.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./authoring.stylex": {
      "types": "./dist/authoring.stylex.d.ts",
      "import": "./src/authoring.stylex.ts",
      "default": "./src/authoring.stylex.ts"
    },
    "./reset.css": "./dist/styles/reset.css",
    "./styles.css": "./dist/styles/index.css",
    "./theme": "./dist/theme.js",
    "./authoring": "./dist/authoring.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "stylex -i src -o dist -b styles/stylex.css --babelPresets @babel/preset-typescript && tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.28.5",
    "@stylexjs/cli": "0.19.0"
  }
}

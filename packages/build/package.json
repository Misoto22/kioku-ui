{
  "name": "@misoto22/kioku-ui-build",
  "version": "0.1.0",
  "description": "Babel, PostCSS, and Vite integrations for Kioku UI source builds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Misoto22/kioku-ui.git",
    "directory": "packages/build"
  },
  "homepage": "https://github.com/Misoto22/kioku-ui#readme",
  "bugs": {
    "url": "https://github.com/Misoto22/kioku-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "postcss.cjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "default": "./dist/babel.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.js",
      "require": "./postcss.cjs",
      "default": "./dist/postcss.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "postcss": "^8.5.10",
    "unplugin": "^2.3.11"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
